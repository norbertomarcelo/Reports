@using Reports.AzureDevOps.Services
@using Reports.AzureDevOps.Views.Models

@model IReadOnlyList<CountRow>

@if (Model.Count == 0)
{
    <p>Nenhum item de trabalho encontrado.</p>
}
else
{
    @await Html.PartialAsync("/Views/AzureDevOps/_CountTable.cshtml", new CountTable("Projeto", Model, Model.Sum(r => r.Open), Model.Sum(r => r.Closed)))
}
