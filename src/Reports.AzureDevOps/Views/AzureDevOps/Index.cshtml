@using Reports.AzureDevOps.Views.Models

@model ReportViewModel

@{
    // Capa, visão geral, <main> e o CSS vêm do design system (spec 020); aqui só o conteúdo dos capítulos.
    Layout = "/Views/DesignSystem/_Layout.cshtml";
}

@if (Model.NoProjects)
{
    <p class="ra-muted">Nenhum projeto encontrado.</p>
}

@if (Model.Projects is not null)
{
    <h1 class="ra-h1">@(Model.Projects.Number). Projetos</h1>

    @await Html.PartialAsync("/Views/AzureDevOps/_ProjectsTable.cshtml", Model.Projects.Content)
}

@if (Model.WorkItems is not null)
{
    <h1 class="ra-h1">@(Model.WorkItems.Number). Itens de trabalho</h1>

    @await Html.PartialAsync("/Views/AzureDevOps/_WorkItemsOverview.cshtml", Model.WorkItems.Content)
}

@foreach (var chapter in Model.ProjectChapters)
{
    @await Html.PartialAsync("/Views/AzureDevOps/_ProjectChapter.cshtml", chapter)
}
