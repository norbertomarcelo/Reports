@using Reports.AzureDevOps.Views.Models
@using Reports.DesignSystem

@model Chapter<IReadOnlyList<RepositoryRow>>

<h2 class="ra-section__title">@Model.Number Repositórios</h2>

@if (Model.Content.Count == 0)
{
    <p class="ra-muted">Nenhum repositório encontrado.</p>
}
else
{
    <div class="ra-table-wrap">
        <table class="ra-table ra-table--ad">
            <thead>
                <tr>
                    <th>Repositório</th>
                    <th>Criador</th>
                    <th class="ra-num">Último commit</th>
                    <th>Autor do último commit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var repository in Model.Content)
                {
                    <tr>
                        <td class="ra-id">
                            @repository.Name
                            @if (repository.IsEmpty)
                            {
                                <span class="ra-badge">Vazio</span>
                            }
                            else if (repository.IsDisabled)
                            {
                                <span class="ra-badge">Desativado</span>
                            }
                        </td>
                        <td>@(repository.Creator ?? "—")</td>
                        <td class="ra-num">@(repository.LastCommitDate is { } date ? Ra.DateTime(date) : "—")</td>
                        <td>@(repository.LastCommitAuthor ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="ra-caption">Criador: autor do primeiro commit do branch padrão.</p>
}
