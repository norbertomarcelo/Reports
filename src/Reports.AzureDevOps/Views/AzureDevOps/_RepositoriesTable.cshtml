@using Reports.AzureDevOps.Views.Models

@model Chapter<IReadOnlyList<RepositoryRow>>

<h2>@Model.Number Repositórios</h2>

@if (Model.Content.Count == 0)
{
    <p>Nenhum repositório encontrado.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Repositório</th>
                <th>Criador</th>
                <th>Último commit</th>
                <th>Autor do último commit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var repository in Model.Content)
            {
                <tr>
                    <td>
                        @repository.Name
                        @if (repository.IsEmpty)
                        {
                            <span class="marca">Vazio</span>
                        }
                        else if (repository.IsDisabled)
                        {
                            <span class="marca">Desativado</span>
                        }
                    </td>
                    <td>@(repository.Creator ?? "—")</td>
                    <td>@(repository.LastCommitDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                    <td>@(repository.LastCommitAuthor ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
    <p>Criador: autor do primeiro commit do branch padrão.</p>
}
