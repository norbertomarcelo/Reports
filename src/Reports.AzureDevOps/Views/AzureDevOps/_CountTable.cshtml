@using Reports.AzureDevOps.Views.Models
@using Reports.DesignSystem

@model CountTable

<div class="ra-table-wrap">
    <table class="ra-table ra-table--ad">
        <thead>
            <tr>
                <th>@Model.Header</th>
                <th class="ra-num">Abertos</th>
                <th class="ra-num">Fechados</th>
                <th class="ra-num">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.Name</td>
                    <td class="ra-num">@Ra.Number(row.Open)</td>
                    <td class="ra-num">@Ra.Number(row.Closed)</td>
                    <td class="ra-num">@Ra.Number(row.Total)</td>
                </tr>
            }
            <tr>
                <td><strong>Total</strong></td>
                <td class="ra-num"><strong>@Ra.Number(Model.Open)</strong></td>
                <td class="ra-num"><strong>@Ra.Number(Model.Closed)</strong></td>
                <td class="ra-num"><strong>@Ra.Number(Model.Open + Model.Closed)</strong></td>
            </tr>
        </tbody>
    </table>
</div>
