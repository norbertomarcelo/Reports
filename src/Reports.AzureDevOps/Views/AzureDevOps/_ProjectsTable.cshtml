@using Reports.AzureDevOps.Views.Models
@using Reports.DesignSystem

@model IReadOnlyList<ProjectRow>

@if (Model.Count == 0)
{
    <p class="ra-muted">Nenhum projeto encontrado.</p>
}
else
{
    <div class="ra-table-wrap">
        <table class="ra-table ra-table--ad">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Estado</th>
                    <th>Visibilidade</th>
                    <th>Processo</th>
                    <th>Controle de versão</th>
                    <th>Git habilitado</th>
                    <th>Permissões do Git configuradas</th>
                    <th class="ra-num">Última Atualização</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Model)
                {
                    <tr>
                        <td>@project.Name</td>
                        <td>@(project.State ?? "—")</td>
                        <td>@(project.Visibility ?? "—")</td>
                        <td>@(project.Details.Process ?? "—")</td>
                        <td>@(project.Details.SourceControl ?? "—")</td>
                        <td>@(project.Details.GitEnabled ?? "—")</td>
                        <td>@(project.Details.GitPermissionsInitialized ?? "—")</td>
                        <td class="ra-num">@Ra.DateTime(project.LastUpdateTime)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
