@using Reports.Api.Services
@using Reports.Api.Views.Models

@model Chapter<WorkItemSummary>

<h2>@Model.Number Itens de trabalho</h2>

@if (Model.Content.Partial)
{
    <p><span class="alerta">Contagem parcial: o Azure DevOps devolveu o resultado em mais de uma página.</span></p>
}

@if (Model.Content.Total == 0)
{
    <p>Nenhum item de trabalho encontrado.</p>
}
else
{
    <p>Total: @Model.Content.Total · Abertos: @Model.Content.Open · Fechados: @Model.Content.Closed</p>

    <p class="rotulo">Por tipo</p>
    @await Html.PartialAsync("_CountTable",
        new CountTable("Tipo", Model.Content.ByType, Model.Content.Open, Model.Content.Closed))

    <p class="rotulo">Por área</p>
    @await Html.PartialAsync("_CountTable",
        new CountTable("Área", Model.Content.ByArea, Model.Content.Open, Model.Content.Closed))
}
