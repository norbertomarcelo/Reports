@using Reports.Api.Services
@using Reports.Api.Views.Models

@model IReadOnlyList<CountRow>

@if (Model.Count == 0)
{
    <p>Nenhum item de trabalho encontrado.</p>
}
else
{
    @await Html.PartialAsync("_CountTable", new CountTable("Projeto", Model, Model.Sum(r => r.Open), Model.Sum(r => r.Closed)))
}
