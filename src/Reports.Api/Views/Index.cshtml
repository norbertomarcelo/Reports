@using Reports.Api.Views.Models

@model ReportViewModel

<style>
    .projetos { font-size: 0.85em; }
    h1 { font-size: 1.6em; margin-top: 1.2em; }
    h2 { font-size: 1.25em; margin-top: 1em; }
    h3 { font-size: 1.05em; margin: 0.8em 0 0.4em 1.2em; }
    .marca { font-size: 0.75em; border: 1px solid #888; border-radius: 3px; padding: 0 0.3em; margin-left: 0.3em; }
    .alerta { color: #b00020; font-weight: bold; }
    .numero { text-align: right; }
    .rotulo { font-weight: bold; margin: 0.6em 0 0.2em; }
    tr.total td { font-weight: bold; }
</style>

@if (Model.NoProjects)
{
    <p>Nenhum projeto encontrado.</p>
}

@if (Model.Projects is not null)
{
    <h1>@(Model.Projects.Number). Projetos</h1>

    @await Html.PartialAsync("_ProjectsTable", Model.Projects.Content)
}

@if (Model.WorkItems is not null)
{
    <h1>@(Model.WorkItems.Number). Itens de trabalho</h1>

    @await Html.PartialAsync("_WorkItemsOverview", Model.WorkItems.Content)
}

@foreach (var chapter in Model.ProjectChapters)
{
    @await Html.PartialAsync("_ProjectChapter", chapter)
}
