@using Reports.Api.Views.Models

@model ReportViewModel

@if (Model.Projects is not null)
{
    <h2>Projetos</h2>

    @if (Model.Projects.Count == 0)
    {
        <p>Nenhum projeto encontrado.</p>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Nome</th>
                    <th>Estado</th>
                    <th>Visibilidade</th>
                    <th>Última Atualização</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Model.Projects)
                {
                    <tr>
                        <td>
                            <a href="@project.Url" target="_blank">@project.Name</a>
                        </td>
                        <td>@project.State</td>
                        <td>@project.Visibility</td>
                        <td>@project.LastUpdateTime.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (Model.Teams is not null)
{
    <h2>Times</h2>

    @if (Model.Teams.Count == 0)
    {
        <p>Nenhum time encontrado.</p>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Projeto</th>
                    <th>Time</th>
                    <th>Descrição</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in Model.Teams)
                {
                    <tr>
                        <td>@team.Project</td>
                        <td>@team.Team</td>
                        <td>@team.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (Model.Users is not null)
{
    <h2>Usuários</h2>

    @if (Model.Users.Count == 0)
    {
        <p>Nenhum usuário encontrado.</p>
    }
    else
    {
        <table class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Projeto</th>
                    <th>Time</th>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Administrador</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Project</td>
                        <td>@user.Team</td>
                        <td>@user.Name</td>
                        <td>@user.Email</td>
                        <td>@(user.IsAdmin ? "Sim" : "Não")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
